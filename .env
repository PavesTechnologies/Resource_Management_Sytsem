# ============================================
# APPLICATION
# ============================================
SPRING_APPLICATION_NAME=ResourceManagementSystem

# ============================================
# DATABASE
# ============================================
RMS_DB_URL=jdbc:mysql://paves-intranet-db-dev.czsgackimf7p.ap-south-1.rds.amazonaws.com:3306/rms
RMS_DB_USERNAME=admin_paves
RMS_DB_PASSWORD=PavesAdmin
RMS_DB_DRIVER=com.mysql.cj.jdbc.Driver

# ============================================
# JPA
# ============================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
DB_MAX_POOL_SIZE=4

# ============================================
# SECURITY
# ============================================
JWT_ISSUER_URI=http://13.207.112.154/ums
SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=admin12345

# ============================================
# SWAGGER
# ============================================
SWAGGER_OPERATIONS_SORTER=alpha

# ============================================
# EXTERNAL AUTH
# ============================================
EXTERNAL_AUTH_URL=http://13.207.112.154/ums/auth/login
EXTERNAL_AUTH_EMAIL=system.internal@pavestechnologies.com
EXTERNAL_AUTH_PASSWORD=System@123

# ============================================
# EXTERNAL API BASE URLS
# ============================================
LEAVE_API_BASE_URL=http://13.207.112.154/lms

# ============================================
# EXTERNAL API ENDPOINTS
# ============================================
HOLIDAY_YEAR_ENDPOINT=/api/holidays/year/{year}
LEAVE_YEAR_ENDPOINT=/api/leave-requests/approved/{year}
LEAVE_EMPLOYEE_ENDPOINT=/api/leave-requests/approved/{employeeId}/{year}

# ============================================
# TOKEN CONFIG
# ============================================
TOKEN_CACHE_MINUTES=5
TOKEN_REFRESH_BUFFER_MINUTES=1

# ============================================
# REDIS
# ============================================
APP_REDIS_ENABLED=true
REDIS_HOST=13.204.95.26
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=Paves@123
REDIS_DATABASE=1
REDIS_TIMEOUT=2000
REDIS_CONNECT_TIMEOUT=2000
CACHE_TYPE=redis

# ============================================
# CDC - PMS
# ============================================
CDC_ENABLED=true

CDC_DB_HOST=paves-intranet-db-dev.czsgackimf7p.ap-south-1.rds.amazonaws.com
CDC_DB_PORT=3306
CDC_DB_USER=admin_paves
CDC_DB_PASSWORD=PavesAdmin
CDC_DB_NAME=pms

CDC_DATABASE_INCLUDE_LIST=pms
CDC_TABLE_INCLUDE_LIST=pms.projects

CDC_BASE_DIR=C:/rms/cdc-data
CDC_SERVER_NAME=pms_mysql
CDC_TOPIC_PREFIX=pms
CDC_SNAPSHOT_MODE=when_needed

# ============================================
# EOS CDC
# ============================================
EOS_CDC_DB_HOST=paves-intranet-db-dev.czsgackimf7p.ap-south-1.rds.amazonaws.com
EOS_CDC_DB_PORT=3306
EOS_CDC_DB_USER=admin_paves
EOS_CDC_DB_PASSWORD=PavesAdmin
EOS_CDC_DB_NAME=eos

EOS_CDC_DATABASE_INCLUDE_LIST=eos
EOS_CDC_TABLE_INCLUDE_LIST=eos.employee_details,eos.employee_exit,eos.offer_letter_details

EOS_CDC_SERVER_NAME=eos_mysql
EOS_CDC_TOPIC_PREFIX=eos
EOS_CDC_CONNECTOR_NAME=eos-cdc
EOS_CDC_SNAPSHOT_MODE=when_needed

# ============================================
# LIFECYCLE ORCHESTRATION
# ============================================
CDC_OFFER_WAITING_MAX_DAYS=45
CDC_OFFER_COMPLETED_RECONCILIATION_MAX_MINUTES=60

# ============================================
# LOGGING
# ============================================
LOGGING_LEVEL_IO_DEBEZIUM=WARN
LOGGING_LEVEL_ORG_APACHE_KAFKA_CONNECT=WARN
LOGGING_LEVEL_REPLAY_THROTTLING_SERVICE=ERROR

SERVER_SERVLET_CONTEXT_PATH=/rms